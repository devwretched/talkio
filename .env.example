# ── Database ──
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=hearth
DB_PORT=5432
# Optional: disable | require | verify-full (defaults to "disable")
DB_SSL_MODE=disable

# ── Server ──
PORT=5070
JWT_SECRET=your-super-secret-key-change-this
# Production frontend origin allowed for CORS / WebSocket origins (e.g. https://hearth.example.com)
APP_ORIGIN=
# Comma-separated user IDs with admin rights (custom emoji management)
ADMIN_USER_IDS=

# ── Google OAuth (required for login) ──
# Client ID of your Google OAuth app (Authorized origins: http://localhost:3000 in dev)
GOOGLE_CLIENT_ID=

# ── Frontend (frontend/.env) ──
# Same Google OAuth client ID, used by the login button
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Backend origin for dev rewrites (default http://localhost:5070) and direct WebSocket base
BACKEND_URL=http://localhost:5070
NEXT_PUBLIC_WS_URL=ws://localhost:5070
