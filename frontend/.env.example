# Required for the Google login button
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Backend origin for /api + /uploads rewrites (build-time env)
BACKEND_URL=http://localhost:5070

# Direct WebSocket base for chat (Next rewrites are HTTP-only).
# Same-origin in prod overlay unless a different backend host is needed.
NEXT_PUBLIC_WS_URL=ws://localhost:5070
